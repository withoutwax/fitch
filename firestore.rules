rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Roles live in users/{uid}.role: "admin", "teacher" or "student".
    // A missing role means student. Tests: rules-tests/firestore.rules.test.ts

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data.get('role', 'student') : 'student';
    }

    function isAdmin() {
      return signedIn() && roleOf(request.auth.uid) == 'admin';
    }

    function isTeacherOrAdmin() {
      return signedIn() && roleOf(request.auth.uid) in ['admin', 'teacher'];
    }

    // The site owner's account becomes the first admin by setting its own role.
    function isBootstrapAdmin() {
      return request.auth.token.email == 'rlagmlckd@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Sign-up consent (src/components/ConsentGate.tsx). Written only by the owner,
    // whole, with the server time. Every item, live activity included, is required.
    function validConsent() {
      let c = request.resource.data.consent;
      return c.keys().hasOnly(['version', 'terms', 'privacy', 'age', 'activity', 'at'])
        && c.version is string && c.terms == true && c.privacy == true && c.age == true && c.activity == true
        && c.at == request.time;
    }

    function consentOk() {
      return !('consent' in request.resource.data)
        || (resource != null && 'consent' in resource.data && request.resource.data.consent == resource.data.consent)
        || validConsent();
    }

    function sharesActivity(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && get(path).data.get('consent', {}).get('activity', false) == true;
    }

    // Teachers and admins may read a student's profile, progress and submitted
    // proofs once the student has agreed to it. Consent version 2026-11-14 covered
    // live activity only, so it does not count.
    function sharesHistory(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let consent = exists(path) ? get(path).data.get('consent', {}) : {};
      return consent.get('activity', false) == true && consent.get('version', '2026-11-14') != '2026-11-14';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow get: if isTeacherOrAdmin() && sharesHistory(uid);

      allow create: if signedIn() && request.auth.uid == uid && consentOk()
        && (!('role' in request.resource.data)
            || (request.resource.data.role == 'admin' && isBootstrapAdmin()));

      // Owners edit their own profile but never their role (except the bootstrap
      // admin promoting itself). Admins change other users' roles and nothing else.
      allow update: if signedIn() && (
        (request.auth.uid == uid && consentOk()
          && (!changedKeys().hasAny(['role'])
              || (request.resource.data.role == 'admin' && isBootstrapAdmin())))
        || (request.auth.uid != uid && isAdmin()
          && changedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'teacher', 'student'])
      );

      allow delete: if signedIn() && request.auth.uid == uid;

      // Progress and submissions: written only by the owner; teachers and admins
      // read them for students who share their history.
      match /{collection}/{rest=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isTeacherOrAdmin() && sharesHistory(uid);
      }
    }

    // Problems are public. They are written only by scripts/upload-problems.ts (Admin SDK).
    match /problems/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Live activity (src/components/PresenceTracker.tsx). Each signed-in student
    // writes only their own doc, and only after opting in; teachers and admins read everyone's.
    match /presence/{uid} {
      allow read: if isTeacherOrAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && sharesActivity(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'path', 'problemId', 'problemTitle',
             'problemSince', 'lineCount', 'idle', 'hidden', 'events', 'heartbeatAt'])
        && request.resource.data.uid == uid
        && request.resource.data.heartbeatAt == request.time
        && request.resource.data.idle is bool
        && request.resource.data.hidden is bool
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && request.resource.data.events is list && request.resource.data.events.size() <= 10;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Model answers are for teachers and admins only.
    match /solutions/{id} {
      allow read: if isTeacherOrAdmin();
      allow write: if false;
    }

    // Bug reports sent from a problem page (src/components/ReportBug.tsx). Anyone
    // sends one, guests included; a signed-in reporter is recorded as themselves
    // and a guest as nobody. Only admins read them and mark them resolved.
    match /bugReports/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['problemId', 'problemTitle', 'message', 'proof', 'path',
             'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['problemId', 'problemTitle', 'message', 'proof', 'path',
             'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.problemId is string && request.resource.data.problemId.size() <= 100
        && request.resource.data.problemTitle is string && request.resource.data.problemTitle.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.proof is list && request.resource.data.proof.size() <= 200
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && request.resource.data.uid == (signedIn() ? request.auth.uid : null)
        && request.resource.data.email == (signedIn() ? request.auth.token.get('email', null) : null)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'resolved'];
      allow delete: if false;
    }
  }
}
